{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wgr-clip",
  "version": "0.1.0",
  "identifier": "ch.wgr.clip",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wgr-clip",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#232323"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "category": "Video",
    "shortDescription": "Drag-drop video transcoder for the web",
    "longDescription": "Convert any video to web-optimized MP4 (H.264/AAC) in 1080p, 4K or source resolution. Drag, drop, done. By WGR."
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY",
      "endpoints": [
        "https://github.com/wgr-sa/wgr-clip/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
